{
  "name": "The Garden",
  "description": "Two people and a god. The people eat, keep company, share or quarrel over food. The god watches and, every few ticks, blesses, tests, shows mercy or stays silent. You are a second god: send droughts, rain, floods or manna and see how the first god and the two people respond.",
  "seed": 6,
  "plugins": ["garden_plugin.py"],
  "narrate_every": 25,
  "environment": {
    "width": 30,
    "height": 20,
    "terrains": {
      "water": {"glyph": "~", "color": "#2a5d8f", "passable": false, "move_cost": 1.0, "capacity": 0.0},
      "sand":  {"glyph": ",", "color": "#c9b87a", "passable": true,  "move_cost": 1.0, "capacity": 0.15},
      "grass": {"glyph": ".", "color": "#5f9e4f", "passable": true,  "move_cost": 1.0, "capacity": 1.0},
      "wood":  {"glyph": "^", "color": "#2f6b3a", "passable": true,  "move_cost": 1.3, "capacity": 0.6},
      "mount": {"glyph": "M", "color": "#b9b3c9", "passable": true,  "move_cost": 2.0, "capacity": 0.0}
    },
    "fields": [
      {"name": "plants", "max": 1.0, "init_fraction_of_capacity": 0.8, "color": "#3fa34d"}
    ],
    "generator": {
      "kind": "noise_terrain",
      "params": {
        "scale": 9, "octaves": 3, "island": 0.5,
        "bands": [[0.28, "water"], [0.34, "sand"], [0.92, "grass"], [1.01, "mount"]],
        "patches": [{"on": "grass", "to": "wood", "scale": 5, "threshold": 0.6}]
      }
    },
    "agents": [
      {"kind": "season", "params": {"period": 120}},
      {"kind": "weather", "params": {"storm_chance": 0.004}}
    ]
  },
  "agent_types": [
    {
      "name": "person", "glyph": "@", "color": "#f2a65a",
      "brain": "person", "brain_params": {"vision": 6},
      "max_energy": 30, "metabolism": 0.3, "max_population": 2,
      "initial": {"count": 2, "terrains": ["grass", "wood"], "energy": 20},
      "attr_choices": {"temper": ["gentle", "proud"]}
    },
    {
      "name": "god", "glyph": "G", "color": "#f4f1de", "tier": "llm",
      "brain": "deity", "brain_params": {"think_every": 8},
      "max_energy": 1, "metabolism": 0.0, "max_population": 1,
      "habitat": ["mount"],
      "initial": {"count": 1, "terrains": ["mount"], "energy": 1}
    }
  ],
  "relationships": [
    {"source": "person", "kind": "eats", "target": "field:plants", "params": {"gain": 1.0}},
    {"source": "person", "kind": "affinity", "target": "person", "params": {"initial": 0.0}}
  ],
  "systems": [
    {"kind": "plant_growth", "phase": "pre", "params": {"field": "plants", "rate": 0.1}},
    {"kind": "metabolism"},
    {"kind": "affinity_decay", "params": {"rate": 0.01}}
  ],
  "perturbations": ["drought", "heavy_rain", "storm", "flood", "terraform", "introduce", "manna"]
}